@model HomeLibrary.Mvc.Models.Book
@{
    ViewData["Title"] = "Удаление книги";
}

<h1>Удаление книги</h1>

<h3>Вы уверены, что хотите удалить эту книгу?</h3>

<div class="card my-3">
    <div class="card-body">
        <h4>@Model.Title</h4>
        <p class="text-muted">@Model.Author (@(Model.PublicationYear?.ToString() ?? "год не указан"))</p>
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Удалить</button>
    <a asp-action="Index" class="btn btn-secondary">Отмена</a>
</form>
